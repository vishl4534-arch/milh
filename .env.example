ELEVENLABS_VOICE_IDS={"en":"","ur":""}
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MEDIA_DIR=./media
MQTT_URL=mqtt://localhost:1883
CORS_ORIGINS=["http://localhost:5173"]
