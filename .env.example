# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./milh.db
# DATABASE_URL=postgresql+psycopg://milh:milh@db:5432/milh
JWT_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# JSON map language -> ElevenLabs voice id
ELEVENLABS_VOICE_IDS={"en":"","ur":""}
# Announcer voice (male, Urdu + English); leave out to use the default, Amjid from the ElevenLabs library
#ELEVENLABS_ANNOUNCE_VOICE_IDS={"en":"vH5LP38dcYJ3CIbC2rKX","ur":"vH5LP38dcYJ3CIbC2rKX"}
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MEDIA_DIR=./media
MQTT_URL=mqtt://localhost:1883
CORS_ORIGINS=["http://localhost:5173"]
# Demo sign-ins on the login pages (run `python -m milh.cli seed-demo --farm <id>` first). Demo/judging only.
DEMO_MODE=false

# --- Voice assistant on the farm tablet (optional) ---
# Needs GEMINI_API_KEY (above) and ELEVENLABS_API_KEY + ELEVENLABS_VOICE_IDS. Without them the Ask button is hidden.
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=gemini-3.5-flash-lite
# Optional backup model (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=4
LLM_HEDGE_SECONDS=1.5
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_TTS_MODEL_ASSISTANT=eleven_v4_turbo
